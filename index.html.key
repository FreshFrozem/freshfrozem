<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <meta name="theme-color" content="#05070b">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <title>iOS Device Scanner</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #05070b;
            --card: #0b0f17;
            --card2: #0f1520;
            --border: #1c2635;
            --text: #f4f7fb;
            --muted: #7f8da3;
            --blue: #1683ff;
            --blue2: #005eff;
            --green: #20d47a;
            --red: #ff5364;
            --yellow: #ffca3a;
        }

        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at 50% -10%, rgba(0, 132, 255, .20), transparent 38%),
                var(--bg);
            color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
                         "SF Pro Text", "Segoe UI", Arial, sans-serif;
        }

        button {
            font: inherit;
        }

        .app {
            width: 100%;
            max-width: 650px;
            margin: auto;
            padding: 22px 16px 45px;
        }

        .header {
            text-align: center;
            padding: 18px 5px 24px;
        }

        .logo {
            width: 70px;
            height: 70px;
            margin: 0 auto 16px;
            border-radius: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(145deg, #147dff, #003d9e);
            box-shadow: 0 0 45px rgba(0, 111, 255, .30);
            font-size: 31px;
        }

        h1 {
            font-size: 27px;
            letter-spacing: -.7px;
        }

        .subtitle {
            margin-top: 7px;
            color: var(--muted);
            font-size: 14px;
        }

        .status {
            margin-top: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: var(--green);
            font-size: 13px;
        }

        .dot {
            width: 8px;
            height: 8px;
            background: var(--green);
            border-radius: 50%;
            box-shadow: 0 0 12px rgba(32, 212, 122, .7);
        }

        .scanner-card {
            background: linear-gradient(145deg, rgba(16,22,33,.96), rgba(8,12,19,.96));
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 20px 70px rgba(0,0,0,.28);
        }

        .scanner {
            position: relative;
            height: 210px;
            border: 1px solid #172338;
            border-radius: 19px;
            background:
                linear-gradient(rgba(20,131,255,.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(20,131,255,.04) 1px, transparent 1px),
                #070b12;
            background-size: 24px 24px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .scanner::before,
        .scanner::after {
            content: "";
            position: absolute;
            width: 35px;
            height: 35px;
            border-color: var(--blue);
            opacity: .8;
        }

        .scanner::before {
            left: 18px;
            top: 18px;
            border-left: 2px solid;
            border-top: 2px solid;
        }

        .scanner::after {
            right: 18px;
            bottom: 18px;
            border-right: 2px solid;
            border-bottom: 2px solid;
        }

        .scan-line {
            position: absolute;
            left: 5%;
            width: 90%;
            height: 2px;
            background: linear-gradient(
                90deg,
                transparent,
                #1690ff,
                #fff,
                #1690ff,
                transparent
            );
            box-shadow: 0 0 18px #1683ff;
            top: 12%;
            opacity: 0;
        }

        .scanner.scanning .scan-line {
            opacity: 1;
            animation: scan 1.7s ease-in-out infinite;
        }

        @keyframes scan {
            0% { top: 10%; }
            50% { top: 88%; }
            100% { top: 10%; }
        }

        .scan-content {
            text-align: center;
            z-index: 2;
        }

        .scan-icon {
            font-size: 42px;
            margin-bottom: 9px;
        }

        .scan-text {
            font-size: 15px;
            font-weight: 600;
        }

        .scan-detail {
            color: var(--muted);
            font-size: 12px;
            margin-top: 5px;
        }

        .progress-area {
            margin-top: 20px;
            display: none;
        }

        .progress-area.show {
            display: block;
        }

        .progress-header {
            display: flex;
            justify-content: space-between;
            color: var(--muted);
            font-size: 12px;
            margin-bottom: 8px;
        }

        .progress-bar {
            width: 100%;
            height: 7px;
            background: #151c28;
            border-radius: 20px;
            overflow: hidden;
        }

        .progress-fill {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, var(--blue2), #34a6ff);
            border-radius: inherit;
            transition: width .2s linear;
            box-shadow: 0 0 12px rgba(22,131,255,.55);
        }

        .button {
            width: 100%;
            margin-top: 20px;
            height: 55px;
            border: 0;
            border-radius: 15px;
            color: white;
            font-weight: 700;
            font-size: 15px;
            background: linear-gradient(135deg, #1683ff, #0058d9);
            box-shadow: 0 12px 30px rgba(0,100,255,.20);
            cursor: pointer;
            transition: transform .15s, opacity .15s;
        }

        .button:active {
            transform: scale(.98);
        }

        .button:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

        .results {
            display: none;
            margin-top: 18px;
        }

        .results.show {
            display: block;
        }

        .result-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 13px;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .item {
            background: var(--card2);
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 15px;
            min-height: 85px;
        }

        .item-label {
            color: var(--muted);
            font-size: 11px;
            margin-bottom: 7px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .item-value {
            font-size: 14px;
            font-weight: 600;
            word-break: break-word;
        }

        .success {
            color: var(--green);
        }

        .warning {
            color: var(--yellow);
        }

        .blocked {
            color: var(--red);
        }

        .notice {
            margin-top: 12px;
            padding: 15px;
            border: 1px solid rgba(255,202,58,.18);
            background: rgba(255,202,58,.05);
            border-radius: 15px;
            color: #d9dce2;
            font-size: 12px;
            line-height: 1.55;
        }

        .notice strong {
            color: var(--yellow);
        }

        .section {
            margin-top: 18px;
        }

        .section-title {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .checks {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .check {
            display: flex;
            align-items: center;
            gap: 11px;
            background: var(--card);
            border: 1px solid var(--border);
            padding: 12px 14px;
            border-radius: 13px;
            font-size: 13px;
        }

        .check-icon {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(32,212,122,.1);
            color: var(--green);
            flex-shrink: 0;
        }

        .footer {
            text-align: center;
            color: #536073;
            font-size: 11px;
            line-height: 1.5;
            margin-top: 25px;
        }

        @media (max-width: 430px) {
            .app {
                padding-left: 12px;
                padding-right: 12px;
            }

            .scanner-card {
                padding: 17px;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            h1 {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>

<div class="app">

    <header class="header">
        <div class="logo">⌁</div>

        <h1>iOS Device Scanner</h1>

        <p class="subtitle">
            Diagnóstico seguro do dispositivo pelo navegador
        </p>

        <div class="status">
            <span class="dot"></span>
            Scanner online
        </div>
    </header>


    <main class="scanner-card">

        <div class="scanner" id="scanner">

            <div class="scan-line"></div>

            <div class="scan-content">
                <div class="scan-icon" id="scanIcon">📱</div>

                <div class="scan-text" id="scanText">
                    Pronto para verificar
                </div>

                <div class="scan-detail" id="scanDetail">
                    Nenhuma verificação iniciada
                </div>
            </div>

        </div>


        <div class="progress-area" id="progressArea">

            <div class="progress-header">
                <span id="progressText">Preparando...</span>
                <span id="progressPercent">0%</span>
            </div>

            <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
            </div>

        </div>


        <button class="button" id="scanButton">
            INICIAR SCANEAMENTO
        </button>


        <section class="results" id="results">

            <div class="result-title">
                Resultado da verificação
            </div>


            <div class="grid">

                <div class="item">
                    <div class="item-label">Dispositivo</div>
                    <div class="item-value" id="deviceResult">
                        —
                    </div>
                </div>

                <div class="item">
                    <div class="item-label">Sistema</div>
                    <div class="item-value" id="osResult">
                        —
                    </div>
                </div>

                <div class="item">
                    <div class="item-label">Navegador</div>
                    <div class="item-value" id="browserResult">
                        —
                    </div>
                </div>

                <div class="item">
                    <div class="item-label">Tela</div>
                    <div class="item-value" id="screenResult">
                        —
                    </div>
                </div>

                <div class="item">
                    <div class="item-label">Conexão</div>
                    <div class="item-value success" id="networkResult">
                        —
                    </div>
                </div>

                <div class="item">
                    <div class="item-label">HTTPS</div>
                    <div class="item-value" id="secureResult">
                        —
                    </div>
                </div>

            </div>


            <div class="section">

                <div class="section-title">
                    Verificações disponíveis
                </div>

                <div class="checks">

                    <div class="check">
                        <span class="check-icon">✓</span>
                        <span>Identificação do tipo de dispositivo</span>
                    </div>

                    <div class="check">
                        <span class="check-icon">✓</span>
                        <span>Informações básicas do navegador</span>
                    </div>

                    <div class="check">
                        <span class="check-icon">✓</span>
                        <span>Resolução e orientação da tela</span>
                    </div>

                    <div class="check">
                        <span class="check-icon">✓</span>
                        <span>Status básico da conexão</span>
                    </div>

                </div>

            </div>


            <div class="section">

                <div class="section-title">
                    Aplicativos do dispositivo
                </div>

                <div class="notice">
                    <strong>⚠ Acesso limitado pelo iOS.</strong><br><br>

                    Um site aberto no Safari não possui uma API que permita
                    listar todos os aplicativos instalados ou aplicativos
                    que foram desinstalados do iPhone. Portanto, esta página
                    não coleta nem finge coletar essa informação.
                    <br><br>

                    Para gerenciamento legítimo de aplicativos é necessário
                    utilizar uma solução de gerenciamento de dispositivos
                    compatível com as APIs de gerenciamento da Apple.
                </div>

            </div>

        </section>

    </main>


    <footer class="footer">
        iOS Device Scanner<br>
        A página só utiliza informações disponibilizadas pelo navegador.
    </footer>

</div>


<script>

    const scanButton = document.getElementById("scanButton");
    const scanner = document.getElementById("scanner");

    const progressArea = document.getElementById("progressArea");
    const progressFill = document.getElementById("progressFill");
    const progressPercent = document.getElementById("progressPercent");
    const progressText = document.getElementById("progressText");

    const results = document.getElementById("results");

    const scanIcon = document.getElementById("scanIcon");
    const scanText = document.getElementById("scanText");
    const scanDetail = document.getElementById("scanDetail");


    function detectDevice() {

        const ua = navigator.userAgent || "";

        if (/iPad/i.test(ua)) {
            return "iPad";
        }

        if (/iPhone/i.test(ua)) {
            return "iPhone";
        }

        if (/iPod/i.test(ua)) {
            return "iPod";
        }

        if (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1) {
            return "iPad";
        }

        if (/Android/i.test(ua)) {
            return "Android";
        }

        if (/Windows/i.test(ua)) {
            return "Windows";
        }

        if (/Mac OS/i.test(ua)) {
            return "Mac";
        }

        return "Desconhecido";
    }


    function detectBrowser() {

        const ua = navigator.userAgent || "";

        if (/CriOS/i.test(ua)) {
            return "Chrome para iOS";
        }

        if (/FxiOS/i.test(ua)) {
            return "Firefox para iOS";
        }

        if (/EdgiOS/i.test(ua)) {
            return "Edge para iOS";
        }

        if (/OPiOS/i.test(ua)) {
            return "Opera para iOS";
        }

        if (/Safari/i.test(ua) && !/Chrome/i.test(ua)) {
            return "Safari";
        }

        if (/Chrome/i.test(ua)) {
            return "Chrome";
        }

        if (/Firefox/i.test(ua)) {
            return "Firefox";
        }

        return "Navegador desconhecido";
    }


    function detectOS() {

        const ua = navigator.userAgent || "";

        let match = ua.match(/OS (\d+)[._](\d+)(?:[._](\d+))?/i);

        if (match) {
            return "iOS " + match[1] + "." + match[2] +
                (match[3] ? "." + match[3] : "");
        }

        match = ua.match(/Android\s+([\d.]+)/i);

        if (match) {
            return "Android " + match[1];
        }

        if (/Windows/i.test(ua)) {
            return "Windows";
        }

        if (/Mac OS X/i.test(ua)) {
            return "macOS";
        }

        return "Sistema não identificado";
    }


    function getNetwork() {

        if (!navigator.onLine) {
            return "Offline";
        }

        if (navigator.connection) {

            const type = navigator.connection.effectiveType;

            if (type) {
                return "Online • " + type.toUpperCase();
            }
        }

        return "Online";
    }


    function getOrientation() {

        if (screen.orientation && screen.orientation.type) {
            return screen.orientation.type;
        }

        return window.innerWidth > window.innerHeight
            ? "landscape"
            : "portrait";
    }


    function runScan() {

        scanButton.disabled = true;
        scanButton.textContent = "SCANEANDO...";

        scanner.classList.add("scanning");

        progressArea.classList.add("show");
        results.classList.remove("show");

        scanIcon.textContent = "🔎";
        scanText.textContent = "Verificando dispositivo...";
        scanDetail.textContent = "Inicializando scanner";

        let progress = 0;

        const steps = [
            "Detectando dispositivo...",
            "Verificando sistema...",
            "Analisando navegador...",
            "Verificando tela...",
            "Verificando conexão...",
            "Finalizando diagnóstico..."
        ];

        const interval = setInterval(() => {

            progress += Math.floor(Math.random() * 8) + 4;

            if (progress > 100) {
                progress = 100;
            }

            progressFill.style.width = progress + "%";
            progressPercent.textContent = progress + "%";

            const stepIndex = Math.min(
                Math.floor(progress / 18),
                steps.length - 1
            );

            progressText.textContent = steps[stepIndex];

            scanText.textContent = steps[stepIndex];

            if (progress === 100) {

                clearInterval(interval);

                setTimeout(showResults, 400);
            }

        }, 180);
    }


    function showResults() {

        const device = detectDevice();
        const os = detectOS();
        const browser = detectBrowser();

        const width = window.screen.width;
        const height = window.screen.height;
        const dpr = window.devicePixelRatio || 1;

        const orientation = getOrientation();

        const secure = window.isSecureContext
            ? "Ativo"
            : "Não ativo";


        document.getElementById("deviceResult").textContent = device;

        document.getElementById("osResult").textContent = os;

        document.getElementById("browserResult").textContent = browser;

        document.getElementById("screenResult").textContent =
            width + " × " + height +
            " • " + orientation +
            " • DPR " + dpr;

        document.getElementById("networkResult").textContent =
            getNetwork();

        document.getElementById("secureResult").textContent =
            secure;


        scanner.classList.remove("scanning");

        scanIcon.textContent = "✓";
        scanText.textContent = "Verificação concluída";
        scanDetail.textContent =
            "As informações disponíveis pelo navegador foram analisadas.";

        progressText.textContent = "Concluído";
        progressPercent.textContent = "100%";

        results.classList.add("show");

        scanButton.disabled = false;
        scanButton.textContent = "ESCANEAR NOVAMENTE";

        results.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });
    }


    scanButton.addEventListener("click", runScan);


    window.addEventListener("online", () => {

        const element = document.getElementById("networkResult");

        if (results.classList.contains("show")) {
            element.textContent = getNetwork();
        }

    });


    window.addEventListener("offline", () => {

        const element = document.getElementById("networkResult");

        if (results.classList.contains("show")) {
            element.textContent = "Offline";
        }

    });

</script>

</body>
</html>
